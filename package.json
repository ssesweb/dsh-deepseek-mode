{
  "name": "dsh-deepseek-mode",
  "version": "0.1.0",
  "description": "DeepSeek web-style mode for DeepSeek Harness: composer toggles (deep think, web search), a DeepSeek agent preset, and per-session web-search gating.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "agent-preset",
    "composer",
    "web-search"
  ],
  "license": "MIT",
  "author": "Tong Li (QuietPhoenix)",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
